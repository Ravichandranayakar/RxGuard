# Environment Mode: development | test | production
ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rxguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rxguard

# Cryptographic Keys (Must be 32 bytes for AES-256)
MASTER_ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_HEX_OR_STRING_KEY!
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_JWT_SECRET_KEY_MIN_32_CHARS!
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Blockchain / Fabric Gateway Configuration
# Mode: "standalone_dev" (for local testing/offline) or "fabric_gateway" (real Hyperledger network)
FABRIC_MODE=standalone_dev
FABRIC_CHANNEL=rxguardchannel
FABRIC_CHAINCODE=prescription
FABRIC_MSP_ID=HospitalMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_CRYPTO_PATH=/crypto/organizations

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
